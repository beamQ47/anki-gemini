# Приклад налаштувань. Справжні значення — у Render Dashboard → Environment
# (або локально в .env, який не комітиться). Секретів тут немає: усі
# значення порожні, це лише список імен, які сервер очікує.
#
# DATABASE_URL — рядок підключення з Supabase. Для безкоштовного Render
# бери саме TRANSACTION POOLER, тобто порт 6543, а не 5432:
#   * прямий порт 5432 в Supabase доступний лише по IPv6, а хости без IPv6
#     (безкоштовні інстанси включно) до нього не дістануться;
#   * пулер переживає засинання інстансу й обрив з'єднання, до того ж
#     db.py уже виставив statement_cache_size=0 саме для нього.
# Формат: postgresql://postgres.<проєкт>:<пароль>@aws-0-<регіон>-pooler.supabase.com:6543/postgres

# --- База (Supabase Postgres) ---
DATABASE_URL=

# або окремо, якщо рядок незручний:
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# --- Gemini ---
# Ключ безкоштовного tier. Спільний для всіх користувачів: ліміт рахується
# на проєкт, а не на ключ-користувача. Саме тому /api/chat закритий
# авторизацією — інакше відкритий ендпоїнт просто витрачав би чужу квоту.
GEMINI_API_KEY=

# Ланцюжок моделей на перевантаженні (за замовчуванням — 4 flash-моделі).
# GEMINI_MODEL_CHAIN=gemini-3.1-flash-lite,gemini-3.5-flash
# Спроб на кожну модель перед переходом до наступної:
# GEMINI_ATTEMPTS_PER_MODEL=2
# 0 вимикає «внутрішні думки» — на безкоштовному ліміті це вигідно.
# GEMINI_THINKING_BUDGET=0
# Повністю вимкнути передавання налаштування думок:
# GEMINI_THINKING=off

# --- Supabase Auth ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Завантаження ---
# Ліміт на файл для Gemini, за замовчуванням 8 МБ.
# MAX_UPLOAD_BYTES=8388608
